{
  "name": "lumatape-desktop",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "LumaTape desktop settings shell",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:ui": "npm run typecheck && vite build",
    "preview:ui": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ui",
    "test:host": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:ui": "node --experimental-default-type=module --test ui/tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  }
}
